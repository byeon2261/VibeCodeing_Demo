# local: 규칙 기반 계획 + SQLite 사용 가능 / live: OpenAI + Supabase 필수
# 동물 데이터는 아래 ANIMAL_API 키가 있으면 local에서도 실제 API를 조회합니다.
APP_MODE=local
STORAGE_BACKEND=sqlite
SQLITE_PATH=.data/meet-again.db
SUPABASE_URL=https://yaywavgjaquftvekuvsb.supabase.co
SUPABASE_SCHEMA=aio-03-p2-team1-demo
# 서버 전용. 지정 스키마의 documents 테이블과 Data API 설정이 필요합니다.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANIMAL_API_KEY=
# ANIMAL_API_SERVICE_KEY도 지원합니다. 두 이름 중 하나만 설정하세요.
ANIMAL_API_BASE_URL=https://apis.data.go.kr/1543061/abandonmentPublicService_v2
KAKAO_REST_API_KEY=
DISCORD_BOT_TOKEN=
# 동의받은 데모 수신자 ID만 허용합니다. 쉼표 구분.
DISCORD_ALLOWED_USER_IDS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_SEARCH_PAGES=3
MAX_REFLECTIONS=2
REQUEST_TIMEOUT_SECONDS=60
# 로그인 세션 저장소. 로컬 Redis 또는 Render Key Value 연결 URL을 사용합니다.
REDIS_URL=redis://127.0.0.1:6380/0
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SAMESITE=lax
# 미설정 시 local=false, live=true. HTTP 로컬 개발 시에만 false를 명시하세요.
# AUTH_COOKIE_SECURE=false
